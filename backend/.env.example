# Copy to backend/.env. Every value is optional.

# Server: run_server.py listens on PORT (production: 4371).
# PORT=4371
# Production: the frontend is served separately on :3371, so the backend serves no build folder.
# FRONTEND_DIR=none

# Database: SQLite by default; Docker Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./indocount.db
# DATABASE_URL=postgresql+psycopg://indocount:indocount@localhost:5432/indocount

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: CORS_ORIGINS=https://indocount.astrikos.xyz:8443,https://indocount.astrikos.xyz
JWT_SECRET=replace-with-a-long-random-string

# Plant clock
SIM_AUTOSTART=true
SIM_TICK_SECONDS=3
SIM_START_HOUR=11
SIM_DEFAULT_SPEED=1

# Business rules (can also be changed at runtime via PUT /api/settings/rules)
DETENTION_CHARGE_USD=350
DETENTION_FREE_MINUTES=120
CHANGEOVER_STANDARD_MINUTES=3
SHIFT2_DIFFERENTIAL_USD=1
EXTRA_BREAK_MINUTES=0

# AI Command Center: "mock" (local engine, no network) or "anthropic" (Claude with tool use)
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# ANTHROPIC_API_KEY=

# Computer vision: "opencv" (OpenCV counter on generated frames) 
CV_PROVIDER=opencv
# CV_VIDEO_SOURCE=rtsp://camera-host/stream   # real camera / video file (optional)

# Future integrations (not connected in the POC)
# SAP_B1_URL=
# HRMS_URL=
# IOT_BROKER_URL=
